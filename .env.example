# ============================================
# CostPilot Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql+asyncpg://costpilot:your_password@localhost:5432/costpilot
MONGODB_URL=mongodb://costpilot:your_password@localhost:27017/costpilot?authSource=admin
MONGO_DB=costpilot
REDIS_URL=redis://:your_password@localhost:6379/0

# ============================================
# Security Keys
# ============================================
# Generate JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your_jwt_secret_here
# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

# ============================================
# Docker Compose Database Credentials
# ============================================
POSTGRES_PASSWORD=your_postgres_password
MONGO_PASSWORD=your_mongo_password
REDIS_PASSWORD=your_redis_password

# ============================================
# AWS SES Email Configuration (Optional)
# ============================================
# To enable email sending via AWS SES:
# 1. Verify sender identity in AWS SES Console
# 2. Create IAM user with ses:SendEmail and ses:SendRawEmail permissions
# 3. Generate access keys and fill in below
# 4. Set EMAIL_PROVIDER=ses

# Email provider: "smtp", "ses", or "sendgrid" (default: smtp)
EMAIL_PROVIDER=ses

# AWS region where SES identity is verified (default: us-east-1)
AWS_REGION=us-east-1

# IAM user credentials for SES
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Verified sender email address in SES
SES_FROM_EMAIL=noreply@costpilot.io

# ============================================
# SendGrid Email Configuration (Optional)
# ============================================
# To enable email sending via SendGrid:
# 1. Create account at sendgrid.com
# 2. Verify sender identity (single sender email for dev)
# 3. Generate API key and fill in below
# 4. Set EMAIL_PROVIDER=sendgrid

# SendGrid API key
# SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Verified sender email address in SendGrid
# SENDGRID_FROM_EMAIL=noreply@costpilot.io

# ============================================
# SMTP Configuration (Alternative to SES/SendGrid)
# ============================================
# If using SMTP instead of SES or SendGrid, configure these:
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_TLS=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@costpilot.io

# ============================================
# Frontend Configuration
# ============================================
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# FRONTEND_BASE_URL=http://localhost:5173
